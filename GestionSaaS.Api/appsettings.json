{
  "BaseDatos": {
    // Sqlite    = archivo local GestionSaaS.Api\Datos\gestionsaas.db (los datos se guardan)
    // Memoria   = solo RAM, se borra al cerrar la Api
    // SqlServer = servidor real (completar ConnectionStrings:SqlServer)
    "Proveedor": "Sqlite"
  },
  "ConnectionStrings": {
    "Sqlite": "Data Source=Datos/gestionsaas.db",
    "SqlServer": ""
  },
  "Jwt": {
    // "Clave" (mínimo 32 caracteres) se define en appsettings.Development.json o variable de entorno Jwt__Clave
    "Clave": "",
    "Emisor": "GestionSaaS",
    "HorasExpiracion": 8
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
      "Microsoft.AspNetCore.Diagnostics.ExceptionHandlerMiddleware": "None"
    }
  },
  "AllowedHosts": "*"
}
